{
  "name": "claude-code-book-template",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "workspaceFolder": "/workspaces/claude-code-book-template",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": ".devcontainer/post_create.sh",
  "postStartCommand": "sudo service mariadb start",
  "mounts": [
    "source=claude-code-config,target=/home/vscode/.claude,type=volume",
    "source=mariadb-data,target=/var/lib/mysql,type=volume"
  ],
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "task-manager",
      "requireLocalPort": true
    }
  }
}
